# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# These variables are not read automatically by Spring Boot from a `.env` file --
# export them into your shell environment before running the app (see README).

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/clean_spring_boot
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_TIME=7200

# Gmail SMTP (used to send signup verification / password reset emails)
# 1. Enable 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Put that 16-character app password below (not your normal Gmail password)
GMAIL_USERNAME=youremail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Email verification on signup. Set to false (default) while debugging locally:
# new users are auto-enabled and no SMTP/OTP email is required. Set to true to
# require clicking the emailed verification link before login is allowed.
EMAIL_VERIFICATION_ENABLED=false
