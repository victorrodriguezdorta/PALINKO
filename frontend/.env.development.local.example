# Copy to .env.development.local (gitignored, overrides .env.development)
# when exposing the backend through a Cloudflare tunnel, instead of editing
# .env.development directly.
VITE_API_BASE_URL=https://your-tunnel-subdomain.trycloudflare.com
VITE_WS_URL=https://your-tunnel-subdomain.trycloudflare.com/ws
